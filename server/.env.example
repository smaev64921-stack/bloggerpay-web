# BloggerPay — настройки сервера-кассы.
# Скопируйте в .env и заполните. .env в репозиторий и в zip не кладут.

# Порт, на котором слушает сервер
PORT=8090

# Ключ оператора: открывает реестр выплат и сводку.
# Придумайте длинную случайную строку и никому не показывайте.
ADMIN_KEY=

# Откуда разрешено ходить браузеру (адрес сайта на Netlify).
# Звёздочка — только для локальной отладки.
ORIGIN=*

# Файл базы. Папка создастся сама.
DB_PATH=./data/bloggerpay.db

# Токен бота из BotFather. Пока пусто — вход по Телеграму отключён,
# приложение работает по email и паролю.
# Как получить: @BotFather → /newbot → токен вида 1234567890:AA...
# Этот же токен использует бот с кнопкой «Открыть» (node server/bot.js).
BOT_TOKEN=

# Адрес мини-аппа для кнопки бота — ТОЛЬКО https, иначе Телеграм её не
# покажет. Это адрес сайта с приложением (например, на Netlify),
# а не адрес этого сервера.
APP_URL=

# Адрес API Телеграма. Менять нужно только если с сервера не открывается
# api.telegram.org (в России это обычное дело) — тогда сюда ставится адрес
# вашего прокси. Пусто = обращаемся к Телеграму напрямую.
TG_API_BASE=

# Адрес, по которому сервер доступен снаружи. Нужен для возврата с площадок
# после подтверждения канала. Локально можно оставить как есть.
PUBLIC_URL=http://127.0.0.1:8090

# Подтверждение владения каналом. Человек входит в свой аккаунт на площадке,
# и она сама сообщает, чей это канал — подделать нельзя.
#
# YouTube: console.cloud.google.com → APIs & Services → Credentials →
#   OAuth client ID (тип «Web application»). В Authorized redirect URIs
#   добавить: <PUBLIC_URL>/api/verify/callback/youtube
#   Включить YouTube Data API v3, доступ youtube.readonly.
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# TikTok: developers.tiktok.com → своё приложение → Login Kit.
#   Redirect URI: <PUBLIC_URL>/api/verify/callback/tiktok
#   Доступы: user.info.basic, user.info.profile, user.info.stats
TT_CLIENT_KEY=
TT_CLIENT_SECRET=

# ── НАСТОЯЩИЙ ПРИЁМ ДЕНЕГ: ЮKassa ──────────────────────────────────
# Кабинет yookassa.ru → Интеграция → Ключи API. Нужен договор
# (ИП или юр. лицо). Как только оба ключа заполнены:
#   · пополнение в приложении идёт через страницу оплаты ЮKassa;
#   · тестовое пополнение выключается автоматически.
# В кабинете кассы укажите адрес вебхука (событие payment.succeeded):
#   <PUBLIC_URL>/api/pay/webhook
# Вебхук не обязателен: приложение само проверяет статус оплаты,
# но с вебхуком зачисление мгновенное.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Куда вернуть человека после оплаты: ссылка на ваш мини-апп,
# например https://t.me/<имя_бота>/<имя_аппа>
PAY_RETURN_URL=

# Тестовое пополнение БЕЗ кассы: 1 — включено (отладка), 0 — выключено.
# При заполненных ключах ЮKassa выключено всегда, что бы ни стояло тут.
TEST_TOPUP=1

# ОБЯЗАТЕЛЬНО НА БОЮ за обратным прокси (Caddy/nginx): 1 — брать адрес
# клиента из X-Forwarded-For. Без этого все запросы выглядят локальными
# и ограничение частоты (защита от перебора паролей) не работает.
TRUST_PROXY=

# ── Тревога в Телеграм ──────────────────────────────────────────
# Каждая новая ошибка сайта (и падение сервера, и расхождение денег)
# прилетает владельцу сообщением через бота. Нужны оба значения:
# BOT_TOKEN выше и числовой id чата владельца с ботом. Узнать свой id:
# написать @userinfobot. Владелец должен один раз нажать Start у бота,
# иначе Телеграм не даст боту писать первым.
ADMIN_CHAT_ID=
