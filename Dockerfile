# ══════════════════════════════════════════════════════════════════════
#  Зачем этот файл: хостинги по умолчанию дают Node 20, а приложению
#  нужен 22.5+. Дело в базе: она встроена в сам Node (node:sqlite) и
#  появилась только в 22.5 — на двадцатом сервер падает сразу при
#  запуске с «No such built-in module: node:sqlite».
#
#  Пишем версию здесь, а не надеемся на engines в package.json: его
#  большинство платформ читает как пожелание, а не как требование.
#
#  Зависимостей у проекта нет вообще — ни npm install, ни package-lock
#  не нужны. Всё, что используется, встроено в Node.
# ══════════════════════════════════════════════════════════════════════
FROM node:22-bookworm-slim

# Код держим ВНЕ /app: Bothost монтирует туда свой том с гитом и данными,
# и файлы образа там просто исчезли бы под монтированием.
WORKDIR /usr/src/app

COPY . .

# База переживает перезапуски и обновления только в томе хостинга.
# Внутри образа она умерла бы вместе с контейнером — вместе с деньгами.
ENV DB_PATH=/app/data/bloggerpay.db
RUN mkdir -p /app/data

# Порт сервер берёт из PORT, если хостинг его задаёт; иначе 8090.
EXPOSE 8090

# Один процесс: сайт, касса и телеграм-бот.
CMD ["node", "server/server.js"]
